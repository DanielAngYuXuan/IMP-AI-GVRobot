import subprocess
import speech_recognition as sr

SPEAK = False  # change to True once your USB speaker is connected

# What you say  ->  what gets printed (and spoken if SPEAK is True)
COMMANDS = {
    "hello": "Hello! The voice command system is working.",
    "lights on": "Output: LIGHTS ON",
    "lights off": "Output: LIGHTS OFF",
    "status": "Output: System is running normally.",
    "stop": "Stopping the program. Goodbye!",
}


def speak(text):
    if SPEAK:
        subprocess.run(["espeak-ng", text])


def handle(text):
    text = text.lower()
    for phrase, output in COMMANDS.items():
        if phrase in text:
            print(output)
            speak(output)
            return phrase
    print("Command not recognised.")
    return None


recognizer = sr.Recognizer()
mic = sr.Microphone()  # if it picks the wrong mic, use sr.Microphone(device_index=N)

with mic as source:
    recognizer.adjust_for_ambient_noise(source, duration=1)

print("Ready. Say one of:", ", ".join(COMMANDS))

while True:
    with mic as source:
        print("\nListening...")
        try:
            audio = recognizer.listen(source, timeout=10, phrase_time_limit=5)
        except sr.WaitTimeoutError:
            continue

    try:
        text = recognizer.recognize_google(audio)
        print("Heard:", text)
    except sr.UnknownValueError:
        print("Could not understand, try again.")
        continue
    except sr.RequestError as e:
        print("Service error (check internet):", e)
        continue

    if handle(text) == "stop":
        break
